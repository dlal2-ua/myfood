# --- General ---
APP_ENV=production            # development | production
APP_URL=https://myfood.cartagena.dpdns.org
APP_PORT=8092                 # puerto expuesto en el host
TZ=Europe/Madrid

# --- Seguridad ---
SECRET_KEY=                   # openssl rand -hex 32
ENCRYPTION_KEY=                # openssl rand -hex 32 -- cifrado de datos de salud y token iafood
SESSION_TTL_DAYS=30

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=myfood
POSTGRES_USER=myfood
POSTGRES_PASSWORD=
# Rol de aplicación sujeto a RLS (distinto del superusuario POSTGRES_USER, ver sección 22)
POSTGRES_APP_ROLE=myfood_app
POSTGRES_APP_PASSWORD=
POSTGRES_ADMIN_ROLE=myfood_admin
POSTGRES_ADMIN_PASSWORD=

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Meilisearch ---
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=

# --- Fuentes de datos ---
USDA_API_KEY=                 # gratuita en api.data.gov
OFF_USER_AGENT="MyFood/1.0 (tu-email@ejemplo.com)"

# --- Imágenes ---
IMAGE_STORAGE_PATH=/data/images
IMAGE_CACHE_BUDGET_GB=20

# --- Notificaciones push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# --- iafood ---
# El token NO va aquí: se pega en Ajustes -> Admin -> iafood y se guarda cifrado en BD.
IAFOOD_ENABLED=true
IAFOOD_MODEL=claude-sonnet-4-6

# --- Whisper (transcripción autoalojada, Fase 8) ---
WHISPER_BASE_URL=http://whisper:9000
WHISPER_MODEL=medium
